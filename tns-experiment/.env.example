# SiliconFlow API Key — get from https://cloud.siliconflow.cn/account/ak
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# Vision model (C2: image-only condition)
VLM_MODEL=Qwen/Qwen3.5-4B

# Text model (C1: text-only condition)
TEXT_MODEL=deepseek-ai/DeepSeek-V3.2
